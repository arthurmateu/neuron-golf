# Qwen3.5-4B with one neuron rewired (L6 N6881, dose +1): the IBM neuron.
# Build the GGUF first:  uv run bake.py gguf "L6 N6881 +1" build/qwen3.5-4b-ibm.gguf
FROM ../build/qwen3.5-4b-ibm.gguf
RENDERER qwen3.5
PARSER qwen3.5
PARAMETER temperature 0.7
PARAMETER top_k 20
PARAMETER top_p 0.8
PARAMETER presence_penalty 1.5
